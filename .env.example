# Base URL of the strichliste backend API.
# In production (strichliste serves the SPA), the API is at /api/.
# For local development, point at the public demo deployment OR your own
# self-hosted instance. Note: `npm run dev` with VITE_API set to the demo API
# will write real records to a shared backend; use unique names.

# Production / self-hosted:
# VITE_API="/api/"

# Public demo (default in .env.development):
VITE_API="https://demo.strichliste.org/api/"
